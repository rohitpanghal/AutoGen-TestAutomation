ANTHROPIC_API_KEY=
PORT=4000
TEST_BASE_URL=http://localhost:3000

# Self-heal loop: default number of run->fix->run cycles, and the ceiling a
# per-request maxHealAttempts is clamped to. Defaults to 4.
MAX_HEAL_ATTEMPTS=4

# Set to 1 to run BOTH the authoritative verification test and the heal-agent's
# live browser headed (visible). Off = headless, which is significantly faster
# and also disables the slowMo pacing below.
HEAL_HEADED=0

# Only used when HEAL_HEADED=1: ms of slowMo on the heal-agent browser so a
# human can follow the replay. Defaults to 250.
HEAL_SLOW_MO=250

# Set to 1 for verbose payload/prompt tracing on stdout (the "----- LABEL -----"
# blocks). Off by default. Recorded input values, emails, and long tokens are
# redacted even when this is on...
DEBUG=0

# ...unless this is also 1, which prints those values verbatim. Local debugging
# only — never enable it anywhere the logs are shipped or retained.
DEBUG_UNSAFE_LOGS=0
